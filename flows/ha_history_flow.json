[
  {
    "id": "f9f3fd52b7eaa001",
    "type": "tab",
    "label": "HA Sensor History Fetch",
    "disabled": false,
    "info": "Haalt historische data op van de energie-sensoren via de Home Assistant History API."
  },
  {
    "id": "e8a58fcd76dfe101",
    "type": "inject",
    "z": "f9f3fd52b7eaa001",
    "name": "Elke 30 min + handmatig",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "1800",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 170,
    "y": 120,
    "wires": [
      [
        "2a11c318b2874102"
      ]
    ]
  },
  {
    "id": "2a11c318b2874102",
    "type": "function",
    "z": "f9f3fd52b7eaa001",
    "name": "Bouw history-requests",
    "func": "const BASE_URL = env.get('HA_BASE_URL');\nconst TOKEN = env.get('HA_TOKEN');\n\nif (!BASE_URL || !TOKEN) {\n    node.error('Zet HA_BASE_URL en HA_TOKEN als environment variables in Node-RED.');\n    return null;\n}\n\nconst sensors = [\n  'sensor.p1_meter_5c2faf04849e_active_power',\n  'sensor.epex_spot_data_price',\n  'sensor.lilygo_rs485_3_marstek_battery_state_of_charge',\n  'sensor.soc',\n  'sensor.energy_production_today_remaining',\n  'sensor.energy_production_tomorrow',\n  'sensor.power_production_next_12hours',\n  'sensor.power_production_next_24hours',\n  'sensor.kotsolar_total_power',\n  'sensor.p1_meter_5c2faf04849e_active_average_demand'\n];\n\nconst now = new Date();\nconst start = new Date(now.getTime() - 24 * 3600 * 1000);\n\nmsg.requests = sensors.map((entityId) => {\n  const startIso = start.toISOString();\n  const endIso = now.toISOString();\n  const url = `${BASE_URL.replace(/\\/$/, '')}/api/history/period/${startIso}?filter_entity_id=${encodeURIComponent(entityId)}&end_time=${encodeURIComponent(endIso)}`;\n\n  return {\n    entity_id: entityId,\n    method: 'GET',\n    url,\n    headers: {\n      Authorization: `Bearer ${TOKEN}`,\n      'Content-Type': 'application/json'\n    }\n  };\n});\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 120,
    "wires": [
      [
        "4dc6b54f8193fd03"
      ]
    ]
  },
  {
    "id": "4dc6b54f8193fd03",
    "type": "split",
    "z": "f9f3fd52b7eaa001",
    "name": "Per sensor",
    "splt": "\\n",
    "spltType": "str",
    "arraySplt": 1,
    "arraySpltType": "len",
    "stream": false,
    "addname": "",
    "property": "requests",
    "x": 590,
    "y": 120,
    "wires": [
      [
        "e4e9669f19418d04"
      ]
    ]
  },
  {
    "id": "e4e9669f19418d04",
