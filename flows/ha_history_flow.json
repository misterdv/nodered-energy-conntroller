  {
    "id": "88a519fbe2d2aa06",
    "type": "function",
    "z": "f9f3fd52b7eaa001",
    "name": "Normaliseer history",
    "func": "const entityId = msg.entity_id;\nconst series = Array.isArray(msg.payload) && msg.payload.length ? msg.payload[0] : [];\n\nmsg.topic = entityId;\nmsg.payload = {\n  entity_id: entityId,\n  points: series.map((row) => ({\n    last_changed: row.last_changed,\n    state: row.state\n  }))\n};\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1240,
